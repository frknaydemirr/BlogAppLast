<!DOCTYPE html>
<html lang="en">
<head>
    <%- include("../partials/head") %> 
</head>
<body>
    
    <%- include("../partials/nav") %> 

    <div class="container mt-3">
        <div class="row">
            <div class="col-md-12 mt-3">
                <% if (action == "edit" && blogid) { %>
                 <div class="alert alert-success">
                    <%= blogid %> id numaralı blog güncellendi.
                 </div>
                <% } %>
                
                <% if (action == "create") { %>
                 <div class="alert alert-success">
                    Blog Oluşturuldu.
                 </div>
                <% } %>
                
                <% if (action == "delete") { %>
                 <div class="alert alert-warning">
                    Blog Silindi.
                 </div>
                <% } %>
                
                <table class="table table-bordered table-stripped">
                    <thead>
                        <tr>
                            <th style="width: 50;">id</th>
                            <th style="width: 130;">resim</th>
                            <th>baslik</th>
                            <th style="width: 130;">#</th>
                        </tr>
                    </thead>
                    <tbody>
                        <% blogs.forEach(blog => { %>
                            <tr>
                                <td><%= blog.blogId %></td>
                                <td><img src="/static/images/<%= blog.resim %>" class="img-fluid"></td>
                                <td><%= blog.baslik %></td>
                                <td>
                                    <a class="btn btn-sm btn-primary" href="/admin/blogs/<%= blog.blogId %>">Edit</a>
                                    <a class="btn btn-sm btn-danger" href="/admin/blogs/delete/<%= blog.blogId %>">Delete</a>
                                </td>
                            </tr>
                        <% }) %>
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</body>
</html>