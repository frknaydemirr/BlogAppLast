<!DOCTYPE html>
<html lang="en">
<head>
    <%- include("../partials/head") %> 
</head>
<body>
    
    <%- include("../partials/nav") %> 

    <div class="container mt-3">
          <div class="row">
            <div class="col-md-12 mt-3">
                <table class="table table-bordered table-stripped">
                    <thead>
                        <tr>
                            <th style="width: 50;">id</th>
                            <th  style="width: 130;">resim</th>
                            <th>baslik</th>
                            <th style="width: 130;">#</th>
                        </tr>
                    </thead>
                    <tbody>
                        <tr>
                            <% blogs.forEach(blog => { %>
                                <tr>
                                    <td><%= blog.blogId %></td>
                                    <td><img src="/static/images/<%= blog.resim %>" class="img-fluid" ></td>
                                    <td><%= blog.baslik %></td>
                                    <td>
                                        <a class="btn btn-sm btn-primary" href="/admin/blogs/<%= blog.blogId %>">Edit</a>
                                         <a class="btn btn-sm btn-danger" href="/admin/blogs/<%= blog.blogId %>">Delete</a>
                                    </td>
                                </tr>
                            <% }) %>
                        </tr>
                    </tbody>
                </table>
            </div>
          </div>
    </div>
</body>
</html>